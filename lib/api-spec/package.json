  "private": true,
  "scripts": {
    "codegen": "orval --config ./orval.config.ts && node -e \"['../api-zod/src/index.ts','../api-client-react/src/index.ts'].forEach(f=>{require('fs').writeFileSync(f,require('fs').readFileSync(f,'utf8').split('\\n').filter(l=>!l.includes('api.schemas')).join('\\n').replace(/\\n+$/,'\\n'))})\" && pnpm -w run typecheck:libs"
  },
